<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PomodoroGothic" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/lt_accent_2</item> <!-- Your active highlight (#8D7FA3) -->
        <item name="colorPrimaryVariant">@color/main_purple</item>
        <item name="colorOnPrimary">@color/dk_base_1</item>

        <item name="colorSecondary">@color/lt_accent_2</item>
        <item name="colorOnSecondary">@color/dk_base_1</item>

        <!-- Background of the app -->
        <item name="android:windowBackground">@color/dk_base_1</item>
    </style>

    <style name="DialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/dk_base_1</item>
        <item name="colorAccent">@color/lt_accent_2</item>
        <item name="android:textColorPrimary">@color/lt_accent_1</item>
        <item name="android:windowTitleStyle">@style/GothicDialogTitle</item>
        <item name="buttonBarButtonStyle">@style/GothicDialogButton</item>
    </style>

    <style name="GothicDialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/lt_accent_2</item>
        <item name="android:fontFamily">@font/body_font</item>
    </style>

    <style name="GothicDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/lt_accent_2</item>
        <item name="android:fontFamily">@font/body_font</item>
    </style>
</resources>