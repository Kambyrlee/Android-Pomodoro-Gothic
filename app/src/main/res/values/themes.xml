<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PomodoroGothic" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="DialogTheme" parent="Theme.AppCompat.Dialog.Alert">

        <item name="android:windowBackground">@color/dk_base_1</item>

        <item name="colorAccent">@color/lt_accent_2</item>
        <item name="android:textColorPrimary">@color/lt_accent_1</item>

        <item name="android:windowTitleStyle">@style/GothicDialogTitle</item>
        <item name="buttonBarButtonStyle">@style/GothicDialogButton</item>
    </style>

    <style name="GothicDialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/lt_accent_2</item>
        <item name="android:fontFamily">@font/body_font</item>
    </style>

    <style name="GothicDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/lt_accent_2</item>
        <item name="android:fontFamily">@font/body_font</item>
    </style>
</resources>